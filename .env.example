# Copy to .env (git-ignored). Host-side values; containers override the hostnames.
# Comma-separated: <key> | <name>:<key> (read/write) | <name>:<key>:ro (read-only).
# Give the Django BFF its own named key, e.g. django:<key>. See docs/frontend.md.
API_KEYS=change-me-dev-key
# Browser origins allowed to call the API directly (empty = no CORS headers)
CORS_ORIGINS=
JOB_RUNNER=rq

# Database. Existing PostGIS (recommended on the server): set CONTAINER_DATABASE_URL to it
# as seen from inside the containers, e.g. the platform database
#   CONTAINER_DATABASE_URL=postgresql://icesat2:<pw>@geoai-postgis-1:5432/geohydro
#   EXTERNAL_DB_NETWORK=geoai_default        # the Docker network of that container
# or, for a PostGIS published on a host port: ...@host.docker.internal:<port>/<db>.
# Leave CONTAINER_DATABASE_URL empty to run the bundled PostGIS (COMPOSE_PROFILES=localdb).
# All tables live in the schema `icesat2`. DATABASE_URL is the same database from the host.
CONTAINER_DATABASE_URL=
EXTERNAL_DB_NETWORK=
DATABASE_URL=postgresql://icesat2:icesat2@localhost:55433/icesat2
POSTGRES_PASSWORD=icesat2

# S3 (local: SeaweedFS from docker-compose; read by s3fs/botocore)
AWS_ACCESS_KEY_ID=icesat2
AWS_SECRET_ACCESS_KEY=icesat2-secret
AWS_ENDPOINT_URL=http://localhost:58333
AWS_DEFAULT_REGION=us-east-1
# Non-AWS S3 (SeaweedFS, MinIO, ...): botocore >= 1.36 otherwise streams uploads
# with aws-chunked checksums that these servers store verbatim -> corrupt objects.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
S3_BUCKET=icesat2
S3_PREFIX=icesat2
# Upload once: aws s3 cp egg_2015.tif s3://icesat2/icesat2/reference/egg_2015.tif
EGG2015_URI=s3://icesat2/icesat2/reference/egg_2015.tif

REDIS_URL=redis://localhost:56379/0

# Earthdata Login: only needed for include_cmr=true (CMR search via earthaccess)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# EGM2008 geoid grid for ATL08/ATL03 heights (fetched once from the PROJ CDN)
PROJ_NETWORK=ON
