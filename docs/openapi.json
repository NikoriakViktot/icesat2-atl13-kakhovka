{
  "openapi": "3.1.0",
  "info": {
    "title": "ICESat-2 ingest",
    "description": "Queue ICESat-2 ATL13 (inland water), ATL08 (terrain + canopy) and ATL03 (photons) pulls over any region via SlideRule; results land in S3 (parquet, COG rasters) and PostGIS. Jobs are asynchronous: POST /jobs, then poll GET /jobs/{job_id} until status is 'done' or 'failed'.",
    "version": "0.2.0"
  },
